# Append to ~/.ssh/config on your LOCAL machine.
# When you spin up a new instance, update HostName and Port only.

Host gpu
    HostName 35.164.116.189
    Port 36353
    User root
    # IdentityFile ~/.ssh/id_ed25519   # uncomment/edit if your provider uses a specific key
    # Connection multiplexing: first ssh opens a master connection, every
    # subsequent call (Claude makes many) reuses it instantly - no
    # re-handshake, no re-auth. Master persists 10 min after last use.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    # Survive brief network blips instead of hanging Claude's commands
    ServerAliveInterval 30
    ServerAliveCountMax 4
    # Fail fast if the box is down rather than stalling for 2 minutes
    ConnectTimeout 10
